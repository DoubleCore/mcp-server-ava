{
  "name": "mcp-server-ava",
  "version": "0.1.0",
  "description": "MCP server for AVA: load data, inspect schemas, run SQL, analyze in natural language, and build charts from any MCP client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "antv",
    "ava",
    "visual-analytics",
    "data-analysis",
    "charts"
  ],
  "license": "MIT",
  "mcpName": "io.github.doublecore/mcp-server-ava",
  "author": {
    "name": "DoubleCore",
    "url": "https://github.com/DoubleCore"
  },
  "homepage": "https://github.com/DoubleCore/mcp-server-ava",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoubleCore/mcp-server-ava.git"
  },
  "bugs": {
    "url": "https://github.com/DoubleCore/mcp-server-ava/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server-ava": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependencies": {
    "@antv/ava": "^4.0.0"
  },
  "devDependencies": {
    "@antv/ava": "^4.0.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
